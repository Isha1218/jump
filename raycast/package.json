{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "jump",
  "title": "Jump",
  "description": "Say a phrase, land on the page you mean.",
  "icon": "icon.png",
  "author": "isha1218",
  "license": "MIT",
  "commands": [
    {
      "name": "jump",
      "title": "Jump",
      "description": "Find the page you mean and open it in Chrome",
      "mode": "view",
      "arguments": [
        {
          "name": "query",
          "placeholder": "where to?",
          "type": "text",
          "required": true
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "jumpPath",
      "title": "jump command",
      "description": "Path to the jump CLI",
      "type": "textfield",
      "required": false,
      "default": "~/projects/jump/main/.venv/bin/jump"
    },
    {
      "name": "jevApiKey",
      "title": "Jev API key",
      "description": "Optional. Without it, results use local ranking only.",
      "type": "password",
      "required": false
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint"
  },
  "dependencies": {
    "@raycast/api": "^1.104.12",
    "@raycast/utils": "^2.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
